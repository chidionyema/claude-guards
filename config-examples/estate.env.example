# The credentials every estate job reads, by name only.
# The live file is ~/.config/estate/estate.env and never enters a repo (LAW 21).
# This file exists so the estate can be rebuilt knowing WHAT to set.

TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
