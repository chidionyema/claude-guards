#!/usr/bin/env bash
# Keep http://localhost:8611 pointing at the ops console inside the Fly container.
#
# prospector-engine has NO public IP, deliberately: the ops console is an admin surface with
# write actions on the money rail, and putting it on the open internet is a security decision
# the founder has not made. `fly proxy` gives the same URL the console has always had, over
# Fly's private WireGuard network, with nothing new exposed.
set -uo pipefail
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
exec fly proxy 8611:8611 -a prospector-engine
