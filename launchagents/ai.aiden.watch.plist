<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.aiden.watch</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Plain python3, deliberately. estate-runner is a signed copy of bash and
         it fed this file to the shell. The TCC problem it exists to solve does
         not apply here anyway: Aiden reads ~/.claude/projects and ~/.claude/state
         and never touches ~/Documents, ~/Desktop or ~/Downloads, which are the
         only trees macOS gates by executable identity. -->
    <string>/usr/bin/python3</string>
    <string>/Users/chidionyema/.claude/scripts/aiden/tick.py</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/chidionyema/.claude/state/aiden-watch.log</string>
  <key>StandardErrorPath</key><string>/Users/chidionyema/.claude/state/aiden-watch.log</string>
  <!-- Adaptive, not Background, and this is the whole reason a tick used to die.
       macOS throttles disk I/O for a Background job. Measured 2026-08-23 under
       /usr/bin/python3: one walk of ~/.claude/projects is 9.8s from a shell and the
       identical walk under this job ran past the tick's 240s deadline twice (receipts
       20:40:43Z and 20:52:28Z), at 0.6% CPU, which is a process waiting on a disk it is
       not allowed to read quickly. Adaptive starts at background priority and is promoted
       when the job actually works. -->
  <key>ProcessType</key><string>Adaptive</string>
  <key>LowPriorityIO</key><false/>
  <key>Nice</key><integer>0</integer>
</dict>
</plist>
