<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Otto cockpit: one screen over the sovereign bus (sovereign/cockpit/README.md).
  `bin/sb cockpit` blocks serving http.server forever, so unlike ai.estate.idp this
  job needs KeepAlive, launchd is the only thing bringing it back after a crash
  or a reboot, and there is no self-restarting parent process to rely on instead.

  Install:    bin/idp-install-launchd
  Remove:     launchctl bootout gui/$(id -u)/ai.estate.cockpit
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/chidionyema/.kimi-code/bin:/Users/chidionyema/.local/bin:/Users/chidionyema/.local/bin:/usr/local/bin:/usr/local/opt/node@20/bin:/Users/chidionyema/anaconda3/bin:/Users/chidionyema/anaconda3/condabin:/bin:/usr/local/bin:/System/Cryptexes/App/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/local/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/appleinternal/bin:/usr/local/share/dotnet:~/.dotnet/tools:/Library/Frameworks/Mono.framework/Versions/Current/Commands:/Users/chidionyema/.cargo/bin:/Users/chidionyema/.rvm/bin:/Users/chidionyema/.claude/plugins/cache/claude-plugins-official/mattpocock-skills/1.2.3/bin</string>
		<key>HOME</key>
		<string>/Users/chidionyema</string>
	</dict>
	<key>Label</key>
	<string>ai.estate.cockpit</string>
	<key>Nice</key>
	<integer>5</integer>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/chidionyema/dev/code/idp/bin/sb</string>
		<string>cockpit</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardErrorPath</key>
	<string>/Users/chidionyema/dev/code/idp/run/cockpit-launchd.log</string>
	<key>StandardOutPath</key>
	<string>/Users/chidionyema/dev/code/idp/run/cockpit-launchd.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/chidionyema/dev/code/idp</string>
</dict>
</plist>
