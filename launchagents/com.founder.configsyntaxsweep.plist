<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.founder.configsyntaxsweep</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/python3</string>
		<string>/Users/chidionyema/.claude/scripts/config-syntax-sweep.py</string>
		<string>--broadcast-on-red</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/chidionyema/.claude/state/logs/config-syntax-sweep.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/chidionyema/.claude/state/logs/config-syntax-sweep.out.log</string>
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>_why_user_python</key>
	<string>PYTHON3_SYSTEM is /usr/bin/python3, which is 3.9.6 on this Mac and has no tomllib (stdlib from 3.11). The module now degrades to BLIND rather than crashing, but BLIND on every .toml file is not the job. 3.14.6 is at /usr/local/bin/python3.</string>
</dict>
</plist>
