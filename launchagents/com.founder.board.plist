<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.founder.board</string>
  <!-- ProgramArguments[0] is the ABSOLUTE interpreter, never a bare name. A launchd job with
       arg0 that needs PATH resolution dies at exit 126 and the failure names nothing useful.
       Measured on this machine: 4 of the estate's launchd jobs currently sit at exit 1. -->
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/python3</string>
    <string>/Users/chidionyema/.claude/scripts/founder_board.py</string>
    <string>--html</string>
    <string>/Users/chidionyema/.claude/state/founder-board.html</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/chidionyema/.claude/state/logs/founder-board.out</string>
  <key>StandardErrorPath</key><string>/Users/chidionyema/.claude/state/logs/founder-board.err</string>
  <key>WorkingDirectory</key><string>/Users/chidionyema</string>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>10</integer>
</dict></plist>
