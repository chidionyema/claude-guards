#!/bin/bash
# estate - run the estate audit and show what is wrong.
# The founder types one word. Everything else is this script's problem.
#
#   estate            run the audit, print what is critical, open the page
#   estate --all      also print the warnings
#   estate --no-open  skip the browser
#
# The same audit runs hourly under com.founder.estateaudit. This is the manual run.
set -uo pipefail

AUDIT="$HOME/.claude/scripts/estate/estate_audit.py"
HTML="$HOME/.claude/state/estate-audit.html"
JSON="$HOME/.claude/state/estate-audit.json"

SHOW_WARN=0
OPEN=1
for a in "$@"; do
  case "$a" in
    --all)     SHOW_WARN=1 ;;
    --no-open) OPEN=0 ;;
    -h|--help) sed -n '2,9p' "$0" | cut -c3- ; exit 0 ;;
    *) echo "estate: unknown option $a" >&2; exit 2 ;;
  esac
done

if [ ! -f "$AUDIT" ]; then
  echo "estate: the audit is missing at $AUDIT" >&2
  echo "        git -C ~/.claude/scripts pull   should restore it" >&2
  exit 1
fi

echo "running the estate audit, about 15 seconds..."
# The audit exits 1 when it finds something critical. That is a finding, not a
# breakage. Only 2 and above mean the audit itself could not run.
/usr/bin/python3 "$AUDIT" --html --state >/dev/null 2>&1
rc=$?
if [ "$rc" -gt 1 ] || [ ! -f "$JSON" ]; then
  echo "estate: the audit itself failed (exit $rc). Run it directly to see why:" >&2
  echo "        /usr/bin/python3 $AUDIT --json" >&2
  exit 1
fi

/usr/bin/python3 - "$JSON" "$SHOW_WARN" <<'PY'
import json, sys, time
data = json.load(open(sys.argv[1]))
show_warn = sys.argv[2] == "1"
c = data["counts"]
age = int(time.time() - data["generated_at"])
print()
print("ESTATE AUDIT   %d critical   %d warn   %d unknown   %d clean   (%ds ago)"
      % (c.get("critical",0), c.get("warn",0), c.get("unknown",0), c.get("ok",0), age))

def block(sev, label):
    rows = [r for r in data["rows"] if r["severity"] == sev]
    if not rows:
        return
    print()
    print(label)
    for r in rows:
        print("  %-9s %s" % (r["domain"], r["title"]))
        print("            %s" % r["value"])
        print("            %s" % r["proof"])

block("critical", "NEEDS YOU NOW")
if show_warn:
    block("warn", "WORTH A LOOK")
    block("unknown", "COULD NOT BE MEASURED")
else:
    n = c.get("warn",0) + c.get("unknown",0)
    if n:
        print()
        print("%d more warnings and unmeasured checks. Run  estate --all  to see them." % n)
print()
PY

if [ "$OPEN" = "1" ] && [ -f "$HTML" ]; then
  open "$HTML" 2>/dev/null && echo "the full page is open in your browser"
fi
